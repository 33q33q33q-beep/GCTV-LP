# このファイルをコピーして .env という名前で保存してください（中身を書き換えます）
#
# 手順（ターミナル）:
#   cp .env.example .env
#
# Supabase を使うとき: ダッシュボード → Project Settings → API から URL と anon public key を貼る
# まだ使わないとき: 下の2行は空のまま or コメントアウトでOK（一部はサンプル表示になります）

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 以下は任意（SNS 埋め込みなど）
# VITE_INSTAGRAM_FEED_IFRAME_URL=
# VITE_TIKTOK_USERNAME=gachinkocycletv_gctv
# X タイムライン埋め込み用の完全 URL（任意・未設定なら twitter.com の既定）
# VITE_TWITTER_TIMELINE_HREF=https://twitter.com/GachinkoCycleTV?ref_src=twsrc%5Etfw
